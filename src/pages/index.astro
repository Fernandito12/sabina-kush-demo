---
import '../styles/global.css';
import '../styles/catalog.css';
import '../styles/payment.css';
import { getProducts } from '../lib/products';

const { products, isDemo } = await getProducts();
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '529513109824';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const categories = ['Todo', ...new Set(products.map((product) => product.category).filter(Boolean))];
const peso = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', minimumFractionDigits: 2, maximumFractionDigits: 2 });
const accents = ['lime', 'orange', 'pink', 'blue', 'yellow', 'purple'];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ec" />
    <meta name="description" content="Explora la selección de flores Sabina Kush y Cantón Green. Presentaciones de 28 g con pedido por WhatsApp." />
    <title>Sabina Kush — Flores Cantón Green</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    {gaMeasurementId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>}
    {gaMeasurementId && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){window.dataLayer.push(arguments);};
      window.gtag('js', new Date());
      window.gtag('config', 'G-GYMW4E8S0H');
    </script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <svg class="icon-defs" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <symbol id="icon-leaf" viewBox="0 0 24 24"><path d="M20.5 3.5C12 3.5 5 6.8 5 13a6 6 0 0 0 6 6c6.2 0 9.5-7 9.5-15.5Z"/><path d="M3.5 21c3-5.1 7.2-8.8 13-12"/></symbol>
      <symbol id="icon-thc" viewBox="0 0 24 24"><path d="M12 2.8S5.5 10 5.5 14.6a6.5 6.5 0 0 0 13 0C18.5 10 12 2.8 12 2.8Z"/><path d="M9.5 15.4a2.6 2.6 0 0 0 2.6 2.6"/></symbol>
      <symbol id="icon-weight" viewBox="0 0 24 24"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 8a3 3 0 0 1 6 0M12 12l2 3"/></symbol>
      <symbol id="icon-stock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.6 2.6L16.5 9"/></symbol>
      <symbol id="icon-cap" viewBox="0 0 24 24"><path d="M3 13.5c.3-4.4 4-7.5 9-7.5s8.7 3.1 9 7.5c-2.3 1.8-5.3 2.7-9 2.7s-6.7-.9-9-2.7Z"/><path d="M3 13.5c2.5 1.4 5.5 2.2 9 2.2s6.5-.8 9-2.2M12 6v10.4"/></symbol>
      <symbol id="icon-seed" viewBox="0 0 24 24"><path d="M19.5 4.5c-7.7-.2-13 3.2-13 8.8a6.2 6.2 0 0 0 6.3 6.2c5.5 0 8.9-5.3 8.7-13Z"/><path d="M4 21c2.8-5.3 6.4-8.6 11.4-11.5"/><path d="M7 4v3M5.5 5.5h3"/></symbol>
    </svg>
    <header class="topbar">
      <a class="brand" href="#inicio" aria-label="Sabina Kush, inicio">
        <img src={`${import.meta.env.BASE_URL}images/brand-banner.png`} alt="Sabina Kush, Cantón Green" />
      </a>
      <nav aria-label="Navegación principal">
        <a href="#tienda">La tienda</a>
        <a href="#nosotros">Nuestra onda</a>
      </nav>
      <button class="cart-trigger" id="open-cart" aria-label="Abrir carrito">
        <span class="cart-icon" aria-hidden="true">＋</span><span>Mi pedido</span><b id="cart-count">0</b>
      </button>
    </header>

    <main id="inicio">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-kicker"><span></span> Cantón Green · Flores de la casa</p>
          <h1 id="hero-title">Un perfil<br />verde, <em>hecho</em><br />para ti.</h1>
          <p class="hero-desc">Explora la selección Sabina Kush: perfiles aromáticos, presentación de 28 g y atención por WhatsApp.</p>
          <a class="hero-link" href="#tienda">Explora las variedades <span aria-hidden="true">↘</span></a>
          <div class="hero-stamp" aria-hidden="true"><span>CANTÓN<br />GREEN</span><b>✳</b></div>
        </div>
        <div class="hero-art" aria-label="Selección de flores Cantón Green">
          <div class="art-disc disc-back"></div><div class="art-disc disc-front"></div>
          <img class="mascot" src={`${import.meta.env.BASE_URL}images/brand-mascot.png`} alt="" />
          <div class="art-note"><span>Perfil de la casa</span><strong>Sabina Kush.</strong></div>
          <span class="spark spark-one">✳</span><span class="spark spark-two">✴</span>
          <span class="art-caption">FLORES<br />DE AUTOR</span>
        </div>
        <div class="hero-edge">SABINA KUSH · FLORES DE AUTOR · SABINA KUSH · FLORES DE AUTOR ·</div>
      </section>

      <section class="ticker" aria-label="Detalles de la selección">
        <div class="ticker-track">
          <div class="ticker-group">
            <span>Flores seleccionadas</span><i>✳</i><span>Perfiles aromáticos únicos</span><i>✳</i><span>Presentación de 28 g</span><i>✳</i><span>Arma tu pedido por WhatsApp</span><i>✳</i><span>Gorras Cantón Verde</span><i>✳</i><span>Detalles que hablan por sí solos</span><i>✳</i><span>Explora toda la colección</span><i>✳</i><span>Una selección para cada estilo</span><i>✳</i>
          </div>
          <div class="ticker-group" aria-hidden="true">
            <span>Flores seleccionadas</span><i>✳</i><span>Perfiles aromáticos únicos</span><i>✳</i><span>Presentación de 28 g</span><i>✳</i><span>Arma tu pedido por WhatsApp</span><i>✳</i><span>Gorras Cantón Verde</span><i>✳</i><span>Detalles que hablan por sí solos</span><i>✳</i><span>Explora toda la colección</span><i>✳</i><span>Una selección para cada estilo</span><i>✳</i>
          </div>
        </div>
      </section>

      <section class="shop section-wrap" id="tienda">
        <div class="shop-heading">
          <div><p class="section-kicker">Flores Cantón Green</p><h2>Elige tu perfil</h2></div>
          <label class="search-box"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Busca una variedad" aria-label="Buscar variedades" /></label>
        </div>
        <div class="shop-tools">
          <div class="filters" role="group" aria-label="Filtrar por categoría">
            {categories.map((category, index) => <button class:list={['filter', { active: index === 0 }]} data-category={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}
          </div>
          {isDemo && <span class="demo-badge"><i></i> Catálogo de demostración</span>}
        </div>

        <div class="product-grid" id="product-grid">
          {products.map((product, index) => (
            <article class="product-card" data-name={`${product.name} ${product.description} ${product.category} ${product.snack_type}`.toLowerCase()} data-category={product.category} style={`--accent: var(--${accents[index % accents.length]});`}>
              <div class:list={['product-visual', { 'product-visual--sheet': product.image_fit === 'contain', 'product-visual--accessory': product.category === 'Accesorios' }]}>
                <span class="product-type"><svg class="mini-icon" aria-hidden="true"><use href={product.category === 'Accesorios' ? '#icon-cap' : product.category === 'Semillas' ? '#icon-seed' : '#icon-leaf'} /></svg>{product.category || 'Flores'}</span>
                {product.image ? <button class:list={['product-image-trigger', { 'product-image-trigger--accessory': product.category === 'Accesorios' }]} type="button" aria-label={`Ampliar imagen de ${product.name}`} data-image={product.image} data-image-alt={`Producto ${product.name}`}><img class:list={['product-photo', { 'product-photo--sheet': product.image_fit === 'contain' }]} src={product.image} alt="" loading="lazy" /><span class="image-zoom-hint" aria-hidden="true">⌕ Ampliar</span></button> : <div class={`snack-illustration snack-${index % 6}`} aria-hidden="true"><span>🍃</span><i>Selección</i></div>}
                {!product.unlimited_stock && product.stock < 10 && product.stock > 0 && <span class="low-stock">Quedan {product.stock}</span>}
              </div>
              <div class="product-info">
                <div class="product-heading"><h3>{product.name}</h3></div>
                <div class="product-facts" aria-label={`Detalles de ${product.name}`}>
                  <span class="product-fact"><svg class="mini-icon" aria-hidden="true"><use href={product.category === 'Accesorios' ? '#icon-cap' : product.category === 'Semillas' ? '#icon-seed' : '#icon-leaf'} /></svg>{product.profile_type || product.snack_type || 'Híbrida'}</span>
                  <span class="product-fact"><svg class="mini-icon" aria-hidden="true"><use href={product.category === 'Accesorios' ? '#icon-stock' : product.category === 'Semillas' ? '#icon-stock' : '#icon-thc'} /></svg>{product.product_badge || product.thc_profile || product.intensity || '20–25% THC'}</span>
                  <span class="product-fact"><svg class="mini-icon" aria-hidden="true"><use href="#icon-weight" /></svg>{product.unit_weight || '28 g'}</span>
                  <span class="product-fact"><svg class="mini-icon" aria-hidden="true"><use href="#icon-stock" /></svg>Siempre disponible</span>
                </div>
                <p class="product-summary">{product.summary || product.description}</p>
                <details class="product-details">
                  <summary>Ver ficha completa <span aria-hidden="true">＋</span></summary>
                  <p>{product.description}</p>
                </details>
                <div class="product-bottom"><div><strong>{peso.format(product.price)}</strong><small> / {product.unit_name || 'paquete'}</small></div><button class="add-button" data-id={product.id} aria-label={`Agregar ${product.name} al pedido`} disabled={!product.unlimited_stock && product.stock < 1}>+</button></div>
              </div>
            </article>
          ))}
          <p class="no-results" id="no-results" hidden>No encontramos esa variedad. Prueba con otro nombre.</p>
        </div>
        <p class="catalog-note">Aromas, concentraciones y efectos son orientativos y pueden variar por lote y por persona. No se ofrecen estos productos como tratamiento médico.</p>
      </section>

      <section class="manifesto" id="nosotros">
        <div class="manifesto-mark">SK<span>✳</span></div>
        <p>Una selección de flores,<br />perfiles <em>con carácter</em><br />y atención cercana.</p>
        <a href="#tienda">Ver variedades <span aria-hidden="true">↗</span></a>
      </section>
      <footer><a href="#inicio">Sabina Kush</a><span>Flores Cantón Green · 28 g por presentación</span><span>© {new Date().getFullYear()} Cantón Green</span></footer>
    </main>

    <div class="cart-shade" id="cart-shade"></div>
    <aside class="cart-panel" id="cart-panel" aria-label="Tu pedido" aria-hidden="true">
      <div class="cart-head"><div><p class="section-kicker">Ya casi</p><h2>Tu pedido <span id="panel-count">(0)</span></h2></div><button class="close-cart" id="close-cart" aria-label="Cerrar carrito">×</button></div>
      <div id="cart-items" class="cart-items"><div class="empty-cart"><span>🍃</span><p>Aún no agregas una variedad.</p><button id="browse-products">Ver el catálogo</button></div></div>
      <div class="cart-footer"><div class="cart-total"><span>Total</span><strong id="cart-total">$0.00</strong></div><p class="cart-hint">Consulta los datos de transferencia y continúa tu pedido por WhatsApp.</p><a class="whatsapp-button" id="whatsapp-button" href="#" target="_blank" rel="noopener" aria-disabled="true" aria-haspopup="dialog" aria-controls="payment-dialog">Pedir por WhatsApp <span>↗</span></a><button class="clear-cart" id="clear-cart">Vaciar pedido</button></div>
    </aside>

    <dialog class="payment-dialog" id="payment-dialog" aria-labelledby="payment-title">
      <div class="payment-dialog__header">
        <div><p class="section-kicker">Transferencia bancaria</p><h2 id="payment-title">Datos para tu pago</h2></div>
        <button class="payment-dialog__close" id="close-payment" type="button" aria-label="Cerrar datos de pago">×</button>
      </div>
      <div class="payment-dialog__content">
        <p>Haz la transferencia desde la app de tu banco. Después, envía el comprobante en el chat de WhatsApp para continuar con tu pedido.</p>
        <figure class="payment-card"><img src={`${import.meta.env.BASE_URL}images/payment.png`} alt="Datos bancarios para realizar la transferencia" /><figcaption>Revisa los datos antes de confirmar la transferencia.</figcaption></figure>
      </div>
      <div class="payment-dialog__actions">
        <button class="payment-dialog__back" id="back-to-cart" type="button">Volver al pedido</button>
        <a class="whatsapp-button payment-dialog__continue" id="continue-whatsapp" href="#" target="_blank" rel="noopener">Continuar a WhatsApp <span>↗</span></a>
      </div>
    </dialog>

    <dialog class="image-lightbox" id="image-lightbox" aria-label="Imagen ampliada del producto">
      <button class="lightbox-close" type="button" aria-label="Cerrar imagen ampliada">×</button>
      <img id="lightbox-image" src="" alt="" />
      <p id="lightbox-caption"></p>
    </dialog>

    <script define:vars={{ products, whatsappNumber }}>
      const catalog = products;
      const money = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
      let cart = [];
      const panel = document.querySelector('#cart-panel');
      const shade = document.querySelector('#cart-shade');
      const paymentDialog = document.querySelector('#payment-dialog');
      const lightbox = document.querySelector('#image-lightbox');
      const lightboxImage = document.querySelector('#lightbox-image');
      const closeLightbox = () => lightbox.close();
      document.querySelectorAll('.product-image-trigger').forEach((button) => button.addEventListener('click', () => {
        lightboxImage.src = button.dataset.image;
        lightboxImage.alt = button.dataset.imageAlt;
        document.querySelector('#lightbox-caption').textContent = button.dataset.imageAlt.replace('Flor de ', '');
        lightbox.showModal();
      }));
      document.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
      const openCart = () => { panel.classList.add('open'); shade.classList.add('visible'); panel.setAttribute('aria-hidden', 'false'); document.body.classList.add('cart-open'); };
      const closeCart = () => { panel.classList.remove('open'); shade.classList.remove('visible'); panel.setAttribute('aria-hidden', 'true'); document.body.classList.remove('cart-open'); };
      const render = () => {
        const qty = cart.reduce((sum, item) => sum + item.qty, 0);
        const count = document.querySelector('#cart-count');
        count.textContent = qty;
        count.classList.toggle('has-items', qty > 0);
        document.querySelector('#panel-count').textContent = `(${qty})`;
        const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
        document.querySelector('#cart-total').textContent = money.format(total);
        const items = document.querySelector('#cart-items');
        if (!cart.length) {
          items.innerHTML = '<div class="empty-cart"><span>🍃</span><p>Aún no agregas una variedad.</p><button id="browse-products">Ver el catálogo</button></div>';
          document.querySelector('#browse-products').addEventListener('click', () => { closeCart(); document.querySelector('#tienda').scrollIntoView({ behavior: 'smooth' }); });
        } else {
          items.innerHTML = cart.map((item) => `<div class="cart-row"><div><strong>${escapeHtml(item.name)}</strong><small>${money.format(item.price)} / ${escapeHtml(item.unit)} · ${escapeHtml(item.weight)}</small><button class="remove-item" data-remove="${item.id}">Quitar</button></div><div class="stepper"><button data-step="-1" data-id="${item.id}" aria-label="Quitar una unidad">−</button><span>${item.qty}</span><button data-step="1" data-id="${item.id}" aria-label="Agregar una unidad">+</button></div></div>`).join('');
          items.querySelectorAll('[data-step]').forEach((button) => button.addEventListener('click', () => changeQty(Number(button.dataset.id), Number(button.dataset.step))));
          items.querySelectorAll('[data-remove]').forEach((button) => button.addEventListener('click', () => { cart = cart.filter((item) => item.id !== Number(button.dataset.remove)); render(); }));
        }
        const whatsapp = document.querySelector('#whatsapp-button');
        whatsapp.setAttribute('aria-disabled', cart.length ? 'false' : 'true');
        const message = `Hola, quiero hacer este pedido:\n${cart.map((item) => `• ${item.qty} × ${item.name} (${item.weight}) — ${money.format(item.price * item.qty)}`).join('\n')}\n\nTotal: ${money.format(total)}`;
        const whatsappUrl = cart.length ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : '#';
        whatsapp.href = whatsappUrl;
        document.querySelector('#continue-whatsapp').href = whatsappUrl;
      };
      const changeQty = (id, delta) => { const item = cart.find((entry) => entry.id === id); const product = catalog.find((entry) => entry.id === id); if (!item || !product) return; item.qty = product.unlimited_stock ? item.qty + delta : Math.min(product.stock, item.qty + delta); if (item.qty < 1) cart = cart.filter((entry) => entry.id !== id); render(); };
      document.querySelectorAll('.add-button').forEach((button) => button.addEventListener('click', () => {
        const product = catalog.find((entry) => entry.id === Number(button.dataset.id));
        if (!product || product.stock < 1) return;
        const existing = cart.find((item) => item.id === product.id);
        if (existing) existing.qty = product.unlimited_stock ? existing.qty + 1 : Math.min(product.stock, existing.qty + 1);
        else cart.push({ id: product.id, name: product.name, price: Number(product.price), unit: product.unit_name || 'paquete', weight: product.unit_weight || '28 g', qty: 1 });
        render(); button.textContent = '✓'; setTimeout(() => { button.textContent = '+'; }, 850);
      }));
      document.querySelector('#open-cart').addEventListener('click', openCart);
      document.querySelector('#close-cart').addEventListener('click', closeCart);
      shade.addEventListener('click', closeCart);
      document.querySelector('#clear-cart').addEventListener('click', () => { cart = []; render(); });
      document.querySelector('#whatsapp-button').addEventListener('click', (event) => {
        if (!cart.length) { event.preventDefault(); return; }
        event.preventDefault();
        const trackEvent = window.gtag;
        trackEvent?.('event', 'whatsapp_order_request');
        paymentDialog.showModal();
      });
      document.querySelector('#close-payment').addEventListener('click', () => paymentDialog.close());
      document.querySelector('#back-to-cart').addEventListener('click', () => paymentDialog.close());
      paymentDialog.addEventListener('click', (event) => { if (event.target === paymentDialog) paymentDialog.close(); });
      document.querySelector('#continue-whatsapp').addEventListener('click', () => setTimeout(() => paymentDialog.close(), 0));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeCart(); });
      document.querySelector('#browse-products')?.addEventListener('click', () => { closeCart(); document.querySelector('#tienda').scrollIntoView({ behavior: 'smooth' }); });
      document.querySelectorAll('.filter').forEach((button) => button.addEventListener('click', () => {
        document.querySelectorAll('.filter').forEach((filter) => { filter.classList.remove('active'); filter.setAttribute('aria-pressed', 'false'); });
        button.classList.add('active'); button.setAttribute('aria-pressed', 'true'); filterProducts();
      }));
      document.querySelector('#search').addEventListener('input', filterProducts);
      function filterProducts() {
        const term = document.querySelector('#search').value.trim().toLowerCase();
        const category = document.querySelector('.filter.active')?.dataset.category || 'Todo';
        let visible = 0;
        document.querySelectorAll('.product-card').forEach((card) => { const match = (category === 'Todo' || card.dataset.category === category) && card.dataset.name.includes(term); card.hidden = !match; if (match) visible += 1; });
        document.querySelector('#no-results').hidden = visible > 0;
      }
    </script>
  </body>
</html>
